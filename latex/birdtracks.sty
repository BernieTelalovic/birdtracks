% PGF normally places an arrow's tip at a decoration mark. Shift by half of
% the arrow's measured length so its visible extent is centred on the mark.
\def\bt@centeredarrowright{%
  \pgfarrowtotallength{\bt@arrowtype[scale=\bt@arrowsize]}%
  \pgftransformxshift{.5\pgf@x}%
  \arrow{\bt@arrowtype[scale=\bt@arrowsize]}%
}
\def\bt@centeredarrowleft{%
  \pgfarrowtotallength{\bt@arrowtype[scale=\bt@arrowsize,reversed]}%
  \pgftransformxshift{-.5\pgf@x}%
  \arrowreversed{\bt@arrowtype[scale=\bt@arrowsize]}%
}

