\cs_new_protected:Npn \bt_collect_layer:n #1
  {
    \int_set:Nn \l_bt_projector_phase_int {1}
    \int_zero:N \l_bt_layer_lines_int
    #1
    \int_compare:nNnTF {\l_bt_layer_lines_int} > {0}
      {
        \int_compare:nNnTF {\l_bt_projector_lines_int} = {0}
          {\int_set:Nn \l_bt_projector_lines_int {\l_bt_layer_lines_int}}
          {
            \int_compare:nNnF
              {\l_bt_projector_lines_int} = {\l_bt_layer_lines_int}
              {\bt_projector_error:n {Every layer must contain the same number of lines}}
          }
        \seq_put_right:Nn \l_bt_projector_layers_seq {#1}
      }
      {\bt_projector_error:n {A layer must contain at least one line}}
    \int_zero:N \l_bt_projector_phase_int
  }

\NewDocumentCommand{\layer}{m}
  {
    \int_compare:nNnTF {\l_bt_projector_phase_int} = {0}
      {\bt_collect_layer:n {#1}}
      {\bt_projector_error:n {Layers cannot be nested}}
  }

\cs_new_protected:Npn \bt_render_boundary:nnn #1#2#3
  {
    \bt_set_command_styles:nn {\l_bt_projector_lines_int}{#3}
    \dim_set:Nn \l_bt_draw_left_dim {#1 - \bt@stitchoverlap}
    \dim_set:Nn \l_bt_draw_right_dim {#2 + \bt@stitchoverlap}
    \int_step_inline:nn {\l_bt_projector_lines_int}
      {
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_command_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \dim_set:Nn \l_bt_line_y_dim
          {-\bt@operatorlineseparation * (##1 - 1)}
        \draw[bt/every~line,bt/current-line]
          (\dim_use:N \l_bt_draw_left_dim,\dim_use:N \l_bt_line_y_dim) --
          (\dim_use:N \l_bt_draw_right_dim,\dim_use:N \l_bt_line_y_dim);
      }
  }

\cs_new_protected:Npn \bt_remove_collection_glue:
  {
    \ifdim\lastskip>0pt\relax
      \unskip
      \exp_after:wN \bt_remove_collection_glue:
    \fi
  }

\cs_new_protected:Npn \bt_render_layered_projector:
  {
    \int_compare:nNnTF {\seq_count:N \l_bt_projector_layers_seq} > {0}
      {
        \seq_clear:N \l_bt_projector_layer_widths_seq
        \int_set:Nn \l_bt_projector_phase_int {3}
        \seq_map_inline:Nn \l_bt_projector_layers_seq
          {
            \dim_zero:N \l_bt_layer_content_width_dim
            ##1
            \dim_set:Nn \l_bt_layer_width_dim
              {\l_bt_layer_content_width_dim + 2\bt@projectorlayerpadding}
            \seq_put_right:Nx \l_bt_projector_layer_widths_seq
              {\dim_use:N \l_bt_layer_width_dim}
          }
        \int_zero:N \l_bt_projector_phase_int
        \dim_zero:N \l_bt_projector_right_dim
        \seq_map_inline:Nn \l_bt_projector_layer_widths_seq
          {\dim_add:Nn \l_bt_projector_right_dim {##1}}
        % Layer collection and measurement execute the user's whitespace.
        % Remove all trailing glue before emitting the actual picture.
        \bt_remove_collection_glue:
        \bt@mathaxis=\fontdimen22\textfont2\relax
        \begin{tikzpicture}[
            baseline={([yshift=-\bt@mathaxis]current~bounding~box.center)}]
          \bool_if:NT \l_bt_projector_start_bool
            {
              \exp_args:NnnV \bt_render_boundary:nnn
                {-\bt@projectorboundarylength}{0pt}
                \l_bt_start_options_tl
            }
          \int_set:Nn \l_bt_projector_phase_int {2}
          \dim_zero:N \l_bt_layer_left_dim
          \seq_map_indexed_inline:Nn \l_bt_projector_layers_seq
            {
              \dim_set:Nn \l_bt_layer_right_dim
                {
                  \l_bt_layer_left_dim +
                  \seq_item:Nn \l_bt_projector_layer_widths_seq {##1}
                }
              \int_set:Nn \l_bt_layer_cursor_int {1}
              ##2
              \dim_set:Nn \l_bt_layer_left_dim {\l_bt_layer_right_dim}
            }
          \int_zero:N \l_bt_projector_phase_int
          \bool_if:NT \l_bt_projector_end_bool
            {
              \exp_args:NnnV \bt_render_boundary:nnn
                {\dim_use:N \l_bt_projector_right_dim}
                {\dim_eval:n
                  {\l_bt_projector_right_dim + \bt@projectorboundarylength}}
                \l_bt_end_options_tl
            }
          % Keep the picture's vertical centre on the centre of its strand
          % bundle.  Operator arrangements can otherwise make the natural
          % TikZ bounding box asymmetric and misalign traced endpoints.
          \dim_set:Nn \l_bt_projector_strand_center_dim
            {-\bt@operatorlineseparation * (\l_bt_projector_lines_int - 1) / 2}
          \dim_set:Nn \l_bt_projector_upper_extent_dim
            {\pgf@picmaxy - \l_bt_projector_strand_center_dim}
          \dim_set:Nn \l_bt_projector_lower_extent_dim
            {\l_bt_projector_strand_center_dim - \pgf@picminy}
          \dim_set:Nn \l_bt_projector_half_extent_dim
            {\dim_max:nn {\l_bt_projector_upper_extent_dim}
                         {\l_bt_projector_lower_extent_dim}}
          \path
            (0pt,\dim_eval:n
              {\l_bt_projector_strand_center_dim + \l_bt_projector_half_extent_dim})
            (0pt,\dim_eval:n
              {\l_bt_projector_strand_center_dim - \l_bt_projector_half_extent_dim});
          % Likewise centre the picture horizontally on its actual strand
          % boundaries, independently of operator borders and content.
          \dim_set:Nn \l_bt_projector_left_endpoint_dim {-\bt@stitchoverlap}
          \bool_if:NT \l_bt_projector_start_bool
            {\dim_set:Nn \l_bt_projector_left_endpoint_dim
              {-\bt@projectorboundarylength - \bt@stitchoverlap}}
          \dim_set:Nn \l_bt_projector_right_endpoint_dim
            {\l_bt_projector_right_dim + \bt@stitchoverlap}
          \bool_if:NT \l_bt_projector_end_bool
            {\dim_set:Nn \l_bt_projector_right_endpoint_dim
              {\l_bt_projector_right_dim + \bt@projectorboundarylength
               + \bt@stitchoverlap}}
          \dim_set:Nn \l_bt_projector_span_dim
            {\l_bt_projector_right_endpoint_dim
             - \l_bt_projector_left_endpoint_dim}
          \dim_gset_eq:NN \g_bt_last_projector_span_dim \l_bt_projector_span_dim
          \dim_set:Nn \l_bt_projector_endpoint_center_dim
            {(\l_bt_projector_left_endpoint_dim
              + \l_bt_projector_right_endpoint_dim) / 2}
          \dim_set:Nn \l_bt_projector_left_extent_dim
            {\l_bt_projector_endpoint_center_dim - \pgf@picminx}
          \dim_set:Nn \l_bt_projector_right_extent_dim
            {\pgf@picmaxx - \l_bt_projector_endpoint_center_dim}
          \dim_set:Nn \l_bt_projector_half_width_dim
            {\dim_max:nn {\l_bt_projector_left_extent_dim}
                         {\l_bt_projector_right_extent_dim}}
          \path
            (\dim_eval:n
              {\l_bt_projector_endpoint_center_dim - \l_bt_projector_half_width_dim},0pt)
            (\dim_eval:n
              {\l_bt_projector_endpoint_center_dim + \l_bt_projector_half_width_dim},0pt);
        \end{tikzpicture}
      }
      {\bt_projector_error:n {A projector needs at least one layer}}
  }

\NewDocumentEnvironment{projector}{O{}+b}
  {
    \group_begin:
      \seq_clear:N \l_bt_projector_layers_seq
      \bool_set_false:N \l_bt_projector_start_bool
      \bool_set_false:N \l_bt_projector_end_bool
      \tl_clear:N \l_bt_start_options_tl
      \tl_clear:N \l_bt_end_options_tl
      \int_zero:N \l_bt_projector_phase_int
      \int_zero:N \l_bt_projector_lines_int
      \pgfkeys{/birdtracks/projector,#1}
      \ignorespaces #2\unskip
      \bt_render_layered_projector:
  }
  {
    \int_gset_eq:NN \g_bt_last_projector_lines_int \l_bt_projector_lines_int
    \dim_gset:Nn \g_bt_last_projector_spacing_dim {\bt@operatorlineseparation}
    \group_end:
  }

