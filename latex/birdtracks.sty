}

\tl_new:N \l_bt_yd_covar_tl
\tl_new:N \l_bt_yd_convar_tl
\seq_new:N \l_bt_yd_covar_rows_seq
\seq_new:N \l_bt_yd_convar_rows_seq
\seq_new:N \l_bt_yd_cells_seq
\fp_new:N \l_bt_yd_hpad_fp
\int_new:N \l_bt_yd_covar_rows_int
\int_new:N \l_bt_yd_convar_rows_int
\int_new:N \l_bt_yd_row_cells_int
\dim_new:N \l_bt_yd_cell_x_dim
\dim_new:N \l_bt_yd_cell_y_dim
\tl_new:N \l_bt_yd_cell_tl

\NewDocumentCommand{\covar}{m}
  {\tl_set:Nn \l_bt_yd_covar_tl {#1}}

\NewDocumentCommand{\convar}{m}
  {\tl_set:Nn \l_bt_yd_convar_tl {#1}}

\NewDocumentCommand{\hpad}{m}
  {\fp_set:Nn \l_bt_yd_hpad_fp {#1}}

% Two labels separated by the same southwest-to-northeast diagonal used by
% tableau multiplication.  This is intended as cell content inside ydpair.
\NewDocumentCommand{\splitbox}{mm}
  {
    \begin{tikzpicture}[baseline=(bt~split.base),x=\bt@ydboxsize,y=\bt@ydboxsize]
      \path[use~as~bounding~box] (-.5,-.5) rectangle (.5,.5);
      \draw[draw=\bt@ydlinecolor,line~width=\bt@ydlinewidth]
        (-.5,-.5) -- (.5,.5);
      \node (bt~split)[inner~sep=0pt,anchor=center]
        at (-.23,.18) {\ensuremath{#1}};
      \node[inner~sep=0pt,anchor=center]
        at (.23,-.18) {\ensuremath{#2}};
    \end{tikzpicture}
  }

\cs_new_protected:Npn \bt_yd_prepare_rows:
  {
    \tl_if_blank:VTF \l_bt_yd_covar_tl
      {\seq_clear:N \l_bt_yd_covar_rows_seq}
      {\seq_set_split:NnV
        \l_bt_yd_covar_rows_seq {\\} \l_bt_yd_covar_tl}
    \tl_if_blank:VTF \l_bt_yd_convar_tl
      {\seq_clear:N \l_bt_yd_convar_rows_seq}
      {\seq_set_split:NnV
        \l_bt_yd_convar_rows_seq {\\} \l_bt_yd_convar_tl}
    \int_set:Nn \l_bt_yd_covar_rows_int
      {\seq_count:N \l_bt_yd_covar_rows_seq}
    \int_set:Nn \l_bt_yd_convar_rows_int
      {\seq_count:N \l_bt_yd_convar_rows_seq}
  }

\cs_new_protected:Npn \bt_render_yd_cell:w
  {\@ifnextchar[\bt_render_yd_cell_options:w{\bt_render_yd_cell_options:w[]}}

\cs_new_protected:Npn \bt_render_yd_cell_options:w [#1]#2\q_stop
  {
    \node[bt/yd-cell,#1]
      at (\dim_use:N \l_bt_yd_cell_x_dim,
          \dim_use:N \l_bt_yd_cell_y_dim) {#2};
  }

\cs_new_protected:Npn \bt_render_yd_covar:
  {
    \seq_map_indexed_inline:Nn \l_bt_yd_covar_rows_seq
      {
        \seq_set_split:Nnn \l_bt_yd_cells_seq {&}{##2}
        \seq_map_indexed_inline:Nn \l_bt_yd_cells_seq
          {
            \pgfmathsetlength{\l_bt_yd_cell_x_dim}{
              \the\bt@ydboxsize * (####1 - .5)}
            \pgfmathsetlength{\l_bt_yd_cell_y_dim}{
              -\the\bt@ydboxsize * (##1 - .5)}
            \tl_set:Nn \l_bt_yd_cell_tl {####2}
            \tl_trim_spaces:N \l_bt_yd_cell_tl
            \exp_after:wN \bt_render_yd_cell:w
              \l_bt_yd_cell_tl \q_stop
          }
      }
  }

\cs_new_protected:Npn \bt_render_yd_convar:
  {
    \seq_map_indexed_inline:Nn \l_bt_yd_convar_rows_seq
      {
        \seq_set_split:Nnn \l_bt_yd_cells_seq {&}{##2}
        \int_set:Nn \l_bt_yd_row_cells_int
          {\seq_count:N \l_bt_yd_cells_seq}
        \seq_map_indexed_inline:Nn \l_bt_yd_cells_seq
          {
            \pgfmathsetlength{\l_bt_yd_cell_x_dim}{
              -\the\bt@ydboxsize *
              (\int_use:N \l_bt_yd_row_cells_int - ####1 + .5)}
            \pgfmathsetlength{\l_bt_yd_cell_y_dim}{
              -\the\bt@ydboxsize *
              (\int_use:N \l_bt_yd_covar_rows_int +
               \fp_to_decimal:N \l_bt_yd_hpad_fp + ##1 - .5)}
            \tl_set:Nn \l_bt_yd_cell_tl {####2}
            \tl_trim_spaces:N \l_bt_yd_cell_tl
            \exp_after:wN \bt_render_yd_cell:w
              \l_bt_yd_cell_tl \q_stop
          }
      }
  }

\cs_new_protected:Npn \bt_render_ydpair:
  {
    \bt_yd_prepare_rows:
    \bt@mathaxis=\fontdimen22\textfont2\relax
    \begin{tikzpicture}[
        baseline={([yshift=-\bt@mathaxis]current~bounding~box.center)}]
      \path (0pt,0pt);
      \bt_render_yd_covar:
      \bt_render_yd_convar:
    \end{tikzpicture}
  }

\NewDocumentEnvironment{ydpair}{O{}+b}
  {
    \group_begin:
      \tl_clear:N \l_bt_yd_covar_tl
      \tl_clear:N \l_bt_yd_convar_tl
      \fp_zero:N \l_bt_yd_hpad_fp
      \pgfkeys{/birdtracks/ydpair,#1}
      #2
      \bt_render_ydpair:
  }
  {\group_end:}

