% --------------------------------------------------------------------------
% Young-diagram cells and pairs
% --------------------------------------------------------------------------

\tikzset{
  bt/cell/.style={
    draw=\bt@boxlinecolor,
    fill=\bt@boxfill,
    text=\bt@boxtextcolor,
    line width=\bt@boxlinewidth,
    minimum width=\bt@boxwidth,
    minimum height=\bt@boxheight,
    text width=\bt@boxwidth,
    inner sep=0pt,
    outer sep=0pt,
    align=center,
  },
  bt/fill color/.style={fill=#1},
  bt/line color/.style={draw=#1},
  bt/text color/.style={text=#1},
  bt/dotted cell/.style={bt/cell,dotted},
  bt/divider/.style={},
}

\newcommand{\bt@cell}[2]{%
  \tikz[baseline=(btcell.center)]%
    \node (btcell) [bt/cell,#1] {\ensuremath{#2}};%
}

% A solid cell.  The optional argument is TikZ node styling, so, for
% example, fill=yellow, draw=red, and line width=1pt are all per-cell.
\NewDocumentCommand{\btcell}{O{}m}{\bt@cell{#1}{#2}}

% A dotted cell with the same text, sizing, and colour controls.
\NewDocumentCommand{\btdottedcell}{O{}m}{%
  \bt@cell{bt/dotted cell,#1}{#2}%
}

% A custom-border cell.  Its optional TikZ argument is intentionally not
% restricted: double, dashed, dash pattern, postaction, and path-picture
% styles are all available to the caller.
\NewDocumentCommand{\btcustomcell}{O{}m}{\bt@cell{#1}{#2}}

% A cell split from southwest to northeast.  The two arguments are separate
% centred text areas.  The optional TikZ settings apply to the outer border
% and to the diagonal (for example draw=blue or line width=1pt).
\NewDocumentCommand{\btdivcell}{O{}mm}{%
  \begin{tikzpicture}[
      x=\bt@boxwidth,
      y=\bt@boxheight,
      baseline=.5\bt@boxheight,
      bt/cell,#1]
    \path (0,0) rectangle (1,1);
    \node[inner sep=0pt, text width=.45\bt@boxwidth, align=center]
      at (.25,.5) {\ensuremath{#2}};
    \node[inner sep=0pt, text width=.45\bt@boxwidth, align=center]
      at (.75,.5) {\ensuremath{#3}};
    \draw[bt/divider] (0,0) -- (1,1);
  \end{tikzpicture}%
}

% #2 is matrix material, so rows use \\ and columns use &.  The command is
% valid in both inline math and display math.  Every cell can independently
% choose one of the three cell commands above.
\NewDocumentCommand{\btpair}{O{}m}{%
  \begingroup
    \pgfkeys{/birdtracks,#1}%
    \setlength{\arraycolsep}{\bt@pairsep}%
    \setlength{\extrarowheight}{\bt@pairrowsep}%
    \ensuremath{\begin{matrix}#2\end{matrix}}%
  \endgroup
}

% --------------------------------------------------------------------------
% Birdtrack symmetrisers and antisymmetrisers
% --------------------------------------------------------------------------

\tikzset{
  bt/every line/.style={
    line width=\bt@operatorlinewidth,
    line cap=butt,
  },
  bt/operator/.style={
    draw=\bt@operatorlinecolor,
    fill=\bt@operatorfill,
    text=\bt@operatortextcolor,
    line width=\bt@operatorborderwidth,
    minimum width=\bt@operatorwidth,
    minimum height=\bt@operatorheight,
    inner sep=0pt,
    outer sep=0pt,
    align=center,
  },
}

\ExplSyntaxOn

\seq_new:N \l_bt_in_lines_seq
\seq_new:N \l_bt_out_lines_seq
\int_new:N \l_bt_port_count_int
\int_new:N \l_bt_out_count_int

% These commands are normally used in the btprojector environment.  Their
% bodies are deliberately empty: one line equals one command, and its TikZ
% options belong only to that line.
\NewDocumentCommand{\btin}{O{}}{
  \seq_put_right:Nn \l_bt_in_lines_seq {#1}
}
\NewDocumentCommand{\btout}{O{}}{
  \seq_put_right:Nn \l_bt_out_lines_seq {#1}
}

\cs_new_protected:Npn \bt_render_projector:
  {
    \int_set:Nn \l_bt_port_count_int {\seq_count:N \l_bt_in_lines_seq}
    \int_set:Nn \l_bt_out_count_int {\seq_count:N \l_bt_out_lines_seq}
    \int_compare:nNnTF {\l_bt_port_count_int} = {0}
      {\PackageError{birdtracks}{A projector needs at least one input line}
        {Add one or more \\btin commands to the environment.}}
      {
        \int_compare:nNnTF {\l_bt_port_count_int} = {\l_bt_out_count_int}
          {\bt_render_projector_valid:}
          {\PackageError{birdtracks}{A projector needs the same number of input and output lines}
            {Add matching \\btin and \\btout commands.}}
      }
  }

\cs_new_protected:Npn \bt_render_projector_valid:
  {
    % The height is specified in line-separation units.  Thus, for n ports,
    % the box spans top margin + (n-1) + bottom margin units.
    \pgfmathsetlength{\bt@operatorheight}{
      (\int_use:N \l_bt_port_count_int - 1 + \bt@operatortop +
       \bt@operatorbottom) * \the\bt@operatorlineseparation}
    \pgfmathsetlength{\bt@halfoperatorwidth}{.5 * \the\bt@operatorwidth}
    \pgfmathsetlength{\bt@leftlineend}{
      -\the\bt@halfoperatorwidth - \the\bt@operatorlinelength}
    \pgfmathsetlength{\bt@rightlineend}{
      \the\bt@halfoperatorwidth + \the\bt@operatorlinelength}
    \pgfmathsetlength{\bt@firstport}{
      .5 * \the\bt@operatorheight - \bt@operatortop *
      \the\bt@operatorlineseparation}

    \begin{tikzpicture}[baseline=(btop.center)]
      \seq_map_indexed_inline:Nn \l_bt_in_lines_seq
        {
          \pgfmathsetlength{\bt@portheight}{
            \the\bt@firstport - (##1 - 1) *
            \the\bt@operatorlineseparation}
          \draw[bt/every~line,##2]
            (\the\bt@leftlineend,\the\bt@portheight) --
            (-\the\bt@halfoperatorwidth,\the\bt@portheight);
        }
      \seq_map_indexed_inline:Nn \l_bt_out_lines_seq
        {
          \pgfmathsetlength{\bt@portheight}{
            \the\bt@firstport - (##1 - 1) *
            \the\bt@operatorlineseparation}
          \draw[bt/every~line,##2]
            (\the\bt@halfoperatorwidth,\the\bt@portheight) --
            (\the\bt@rightlineend,\the\bt@portheight);
        }
      \node (btop) [bt/operator,\bt@operatoroptions]
        {\ensuremath{\bt@operator}};
    \end{tikzpicture}
  }

% The body is a list of \btin[...] and \btout[...] commands.  Since it is
% captured before rendering, line count and line geometry are deterministic.
\NewDocumentEnvironment{btprojector}{O{}+b}
  {
    \group_begin:
      \seq_clear:N \l_bt_in_lines_seq
      \seq_clear:N \l_bt_out_lines_seq
      \pgfkeys{/birdtracks,#1}
      #2
      \bt_render_projector:
  }
  {\group_end:}

% A readable S/A-specific spelling.  The first optional argument is S or A;
% the second carries the same local settings accepted by btprojector.
\NewDocumentEnvironment{btSA}{O{S}O{}+b}
  {\begin{btprojector}[operator={#1},#2]#3\end{btprojector}}
  {}

