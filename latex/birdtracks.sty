\cs_new_protected:Npn \bt_count_permutation:n #1
  {
    \seq_set_split:Nnn \l_bt_permutation_source_seq {,}{#1}
    \int_add:Nn \l_bt_layer_lines_int
      {\seq_count:N \l_bt_permutation_source_seq}
  }

\cs_new_protected:Npn \bt_render_permutation:nnn #1#2#3
  {
    \seq_set_split:Nnn \l_bt_permutation_style_seq {,}{#1}
    \seq_set_split:Nnn \l_bt_permutation_source_seq {,}{#2}
    \seq_set_split:Nnn \l_bt_permutation_target_seq {,}{#3}
    \dim_set:Nn \l_bt_draw_left_dim
      {\l_bt_layer_left_dim - \bt@stitchoverlap}
    \dim_set:Nn \l_bt_draw_right_dim
      {\l_bt_layer_right_dim + \bt@stitchoverlap}
    \int_compare:nNnF
      {\seq_count:N \l_bt_permutation_source_seq} =
      {\seq_count:N \l_bt_permutation_target_seq}
      {\bt_projector_error:n {Permutation lists must have equal lengths}}
    \seq_map_indexed_inline:Nn \l_bt_permutation_source_seq
      {
        \dim_set:Nn \l_bt_line_y_dim
          {-\bt@operatorlineseparation * (##1 - 1)}
        \int_set:Nn \l_bt_permutation_target_int
          {\seq_item:Nn \l_bt_permutation_target_seq {##1}}
        \dim_set:Nn \l_bt_target_y_dim
          {-\bt@operatorlineseparation * (\l_bt_permutation_target_int - 1)}
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_permutation_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \draw[bt/every~line,bt/current-line]
          (\dim_use:N \l_bt_draw_left_dim,\dim_use:N \l_bt_line_y_dim)
          .. controls
          ($ (\dim_use:N \l_bt_layer_left_dim,\dim_use:N \l_bt_line_y_dim)!.5!
             (\dim_use:N \l_bt_layer_right_dim,\dim_use:N \l_bt_line_y_dim) $)
          and
          ($ (\dim_use:N \l_bt_layer_left_dim,\dim_use:N \l_bt_target_y_dim)!.5!
             (\dim_use:N \l_bt_layer_right_dim,\dim_use:N \l_bt_target_y_dim) $)
          ..
          (\dim_use:N \l_bt_draw_right_dim,\dim_use:N \l_bt_target_y_dim);
      }
  }

