    inner~sep=0pt,
    outer~sep=0pt,
    align=center,
  },
  text_size/.style={font=#1},
  text~size/.style={font=#1},
}

\pgfkeys{
  /birdtracks/ydpair/.is~family,
  /birdtracks/ydpair,
  box_size/.code={\bt@ydboxsize=#1\relax},
  box~size/.code={\bt@ydboxsize=#1\relax},
  line_width/.code={\bt@ydlinewidth=#1\relax},
