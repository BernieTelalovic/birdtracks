\cs_new_protected:Npn \bt_trace_render_connector:nnnn #1#2#3#4
  {
    \seq_set_split:Nnn \l_bt_permutation_style_seq {,}{#2}
    \seq_set_split:Nnn \l_bt_permutation_source_seq {,}{#3}
    \seq_set_split:Nnn \l_bt_permutation_target_seq {,}{#4}
    \int_compare:nNnF {\seq_count:N \l_bt_permutation_source_seq}
      = {\l_bt_trace_top_lines_int}
      {\bt_projector_error:n {A trace connector must describe every line}}
    \int_compare:nNnF {\seq_count:N \l_bt_permutation_target_seq}
      = {\l_bt_trace_top_lines_int}
      {\bt_projector_error:n {A trace connector permutation has unequal lists}}
    \dim_set:Nn \l_bt_trace_half_width_dim
      {\dim_max:nn {\l_bt_trace_top_span_dim}
                   {\l_bt_trace_bottom_span_dim}/2}
    \seq_map_indexed_inline:Nn \l_bt_permutation_source_seq
      {
        % Bottom source 1 is the innermost lane; successive source positions
        % move outward.  Mapping in source order draws outer lanes last.
        \dim_set:Nn \l_bt_trace_lane_offset_dim
          {\bt@tracelanespacing * (\l_bt_trace_top_lines_int - ##1)}
        \dim_set:Nn \l_bt_trace_lane_reach_dim
          {\dim_max:nn {0pt}
            {\bt@tracereach - \l_bt_trace_lane_offset_dim}}
        \str_if_eq:nnTF {#1}{left}
          {\dim_set:Nn \l_bt_trace_outer_x_dim
            {-\l_bt_trace_half_width_dim - \l_bt_trace_lane_reach_dim}}
          {\dim_set:Nn \l_bt_trace_outer_x_dim
            {\l_bt_trace_half_width_dim + \l_bt_trace_lane_reach_dim}}
        \int_set:Nn \l_bt_permutation_target_int
          {\seq_item:Nn \l_bt_permutation_target_seq {##1}}
        \dim_set:Nn \l_bt_trace_source_y_dim
          {\l_bt_trace_bottom_spacing_dim *
           (\l_bt_trace_bottom_lines_int + 1 - 2 * ##1) / 2}
        \dim_set:Nn \l_bt_trace_target_y_dim
          {\l_bt_trace_top_spacing_dim *
           (\l_bt_trace_top_lines_int + 1 - 2 * \l_bt_permutation_target_int) / 2}
        \dim_set:Nn \l_bt_trace_effective_turn_dim
          {\dim_min:nn {\l_bt_trace_lane_reach_dim}
            {\dim_min:nn {\bt@traceturn}
              {(\l_bt_trace_separation_dim + \l_bt_trace_target_y_dim
                - \l_bt_trace_source_y_dim) / 2}}}
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_permutation_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \str_if_eq:nnTF {#1}{left}
          {\bt_trace_draw_left:}
          {\bt_trace_draw_right:}
      }
  }
\cs_generate_variant:Nn \bt_trace_render_connector:nnnn {nVVV}

\cs_new_protected:Npn \bt_trace_draw_left:
  {
    \dim_compare:nNnTF {\l_bt_trace_effective_turn_dim} = {0pt}
    {
      \draw[bt/every~line,bt/current-line]
        ([xshift=\dim_eval:n {-\l_bt_trace_bottom_span_dim/2},
          yshift=\l_bt_trace_source_y_dim]bttracebottom.center) --
        ([xshift=\dim_eval:n {-\l_bt_trace_top_span_dim/2},
          yshift=\l_bt_trace_target_y_dim]bttracetop.center);
    }
    {
    \draw[bt/every~line,bt/current-line]
      ([xshift=\dim_eval:n {-\l_bt_trace_bottom_span_dim/2},
        yshift=\l_bt_trace_source_y_dim]bttracebottom.center)
      .. controls +(-\l_bt_trace_effective_turn_dim,0pt)
                  and +(0pt,-\l_bt_trace_effective_turn_dim) ..
      (\l_bt_trace_outer_x_dim,
       \dim_eval:n {-\l_bt_trace_separation_dim/2+\l_bt_trace_source_y_dim
                    +\l_bt_trace_effective_turn_dim})
      --
      (\l_bt_trace_outer_x_dim,
       \dim_eval:n {\l_bt_trace_separation_dim/2+\l_bt_trace_target_y_dim
                    -\l_bt_trace_effective_turn_dim})
      .. controls +(0pt,\l_bt_trace_effective_turn_dim)
                  and +(-\l_bt_trace_effective_turn_dim,0pt) ..
      ([xshift=\dim_eval:n {-\l_bt_trace_top_span_dim/2},
        yshift=\l_bt_trace_target_y_dim]bttracetop.center);
    }
  }

\cs_new_protected:Npn \bt_trace_draw_right:
  {
    \dim_compare:nNnTF {\l_bt_trace_effective_turn_dim} = {0pt}
    {
      \draw[bt/every~line,bt/current-line]
        ([xshift=\dim_eval:n {\l_bt_trace_bottom_span_dim/2},
          yshift=\l_bt_trace_source_y_dim]bttracebottom.center) --
        ([xshift=\dim_eval:n {\l_bt_trace_top_span_dim/2},
          yshift=\l_bt_trace_target_y_dim]bttracetop.center);
    }
    {
    \draw[bt/every~line,bt/current-line]
      ([xshift=\dim_eval:n {\l_bt_trace_bottom_span_dim/2},
        yshift=\l_bt_trace_source_y_dim]bttracebottom.center)
      .. controls +(\l_bt_trace_effective_turn_dim,0pt)
                  and +(0pt,-\l_bt_trace_effective_turn_dim) ..
      (\l_bt_trace_outer_x_dim,
       \dim_eval:n {-\l_bt_trace_separation_dim/2+\l_bt_trace_source_y_dim
                    +\l_bt_trace_effective_turn_dim})
      --
      (\l_bt_trace_outer_x_dim,
       \dim_eval:n {\l_bt_trace_separation_dim/2+\l_bt_trace_target_y_dim
                    -\l_bt_trace_effective_turn_dim})
      .. controls +(0pt,\l_bt_trace_effective_turn_dim)
                  and +(\l_bt_trace_effective_turn_dim,0pt) ..
      ([xshift=\dim_eval:n {\l_bt_trace_top_span_dim/2},
        yshift=\l_bt_trace_target_y_dim]bttracetop.center);
    }
  }

\cs_new_protected:Npn \bt_render_traced_projector:
  {
    \int_compare:nNnF {\l_bt_trace_top_lines_int} = {\l_bt_trace_bottom_lines_int}
      {\bt_projector_error:n {Top and bottom projectors must have the same number of lines}}
    \dim_set:Nn \l_bt_trace_separation_dim
      {(\box_ht:N \l_bt_trace_top_box + \box_dp:N \l_bt_trace_top_box
       + \box_ht:N \l_bt_trace_bottom_box + \box_dp:N \l_bt_trace_bottom_box)/2
       + \bt@tracegap}
    \bt@mathaxis=\fontdimen22\textfont2\relax
    \begin{tikzpicture}[baseline={([yshift=-\bt@mathaxis]current~bounding~box.center)}]
      \node[inner~sep=0pt] (bttracetop)
        at (0pt,\dim_eval:n {\l_bt_trace_separation_dim/2})
        {\box_use:N \l_bt_trace_top_box};
      \node[inner~sep=0pt] (bttracebottom)
        at (0pt,\dim_eval:n {-\l_bt_trace_separation_dim/2})
        {\box_use:N \l_bt_trace_bottom_box};
      \bt_trace_render_connector:nVVV {left}
        \l_bt_trace_left_styles_tl \l_bt_trace_left_source_tl \l_bt_trace_left_target_tl
      \bt_trace_render_connector:nVVV {right}
        \l_bt_trace_right_styles_tl \l_bt_trace_right_source_tl \l_bt_trace_right_target_tl
    \end{tikzpicture}
  }

\NewDocumentEnvironment{tracedprojector}{O{}+b}
  {
    \group_begin:
      \int_zero:N \l_bt_trace_top_lines_int
      \int_zero:N \l_bt_trace_bottom_lines_int
      \tl_clear:N \l_bt_trace_left_styles_tl
      \tl_clear:N \l_bt_trace_right_styles_tl
      \pgfkeys{/birdtracks,#1}
      \int_set:Nn \l_bt_projector_phase_int {4}
      \tl_set:Nn \l_bt_trace_body_tl {#2}
      \tl_remove_all:Nn \l_bt_trace_body_tl {\par}
      \tl_use:N \l_bt_trace_body_tl
      \int_zero:N \l_bt_projector_phase_int
      \bt_render_traced_projector:
  }
  {\group_end:}

