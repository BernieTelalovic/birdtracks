\cs_new_protected:Npn \bt_projector_error:n #1
  {\PackageError{birdtracks}{#1}{Check the projector layer syntax.}}

% A leading bare direction marker is notation rather than a raw TikZ key.
% Everything after it remains ordinary TikZ draw options.
\cs_new_protected:Npn \bt_prepare_line_options:n #1
  {
    \tl_set:Nn \l_bt_line_options_tl {#1}
    % Accept the common math-mode spelling \> as well as the bare marker >.
    \tl_replace_once:Nnn \l_bt_line_options_tl {\>} {>}
    \regex_replace_once:nnN
      {\A\s*<\s*,?} {bt/arrow-left,} \l_bt_line_options_tl
    \regex_replace_once:nnN
      {\A\s*>\s*,?} {bt/arrow-right,} \l_bt_line_options_tl
    \tikzset{
      bt/current-line/.style/.expanded={\l_bt_line_options_tl}
    }
  }

\cs_new_protected:Npn \bt_count_lines:n #1
  {\int_add:Nn \l_bt_layer_lines_int {#1}}

\cs_new_protected:Npn \bt_measure_minimum_operator:
  {
    \dim_set:Nn \l_bt_layer_content_width_dim
      {\dim_max:nn {\l_bt_layer_content_width_dim}{\bt@operatorwidth}}
  }

\cs_new_protected:Npn \bt_measure_operator_content:n #1
  {
    \hbox_set:Nn \l_bt_operator_content_box {#1}
    \dim_set:Nn \l_bt_layer_content_width_dim
      {
        \dim_max:nn
          {\l_bt_layer_content_width_dim}
          {\dim_max:nn {\bt@operatorwidth}{\box_wd:N \l_bt_operator_content_box}}
      }
  }

\cs_new_protected:Npn \bt_measure_permutation:
  {
    \dim_compare:nNnTF {\bt@permutationminwidth} > {0pt}
      {\dim_set:Nn \l_bt_layer_content_width_dim {\bt@permutationminwidth}}
      {\bt_measure_minimum_operator:}
  }

\cs_new_protected:Npn \bt_set_command_styles:nn #1#2
  {
    \int_compare:nNnTF {#1} = {1}
      {
        \seq_clear:N \l_bt_command_style_seq
        \seq_put_right:Nn \l_bt_command_style_seq {#2}
      }
      {\seq_set_split:Nnn \l_bt_command_style_seq {,}{#2}}
  }

\cs_new_protected:Npn \bt_render_plain_lines:nn #1#2
  {
    \bt_set_command_styles:nn {#1}{#2}
    \dim_set:Nn \l_bt_draw_left_dim
      {\l_bt_layer_left_dim - \bt@stitchoverlap}
    \dim_set:Nn \l_bt_draw_right_dim
      {\l_bt_layer_right_dim + \bt@stitchoverlap}
    \int_step_inline:nn {#1}
      {
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_command_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \dim_set:Nn \l_bt_line_y_dim
          {-\bt@operatorlineseparation * (\l_bt_layer_cursor_int + ##1 - 2)}
        \draw[bt/every~line,bt/current-line]
          (\dim_use:N \l_bt_draw_left_dim,\dim_use:N \l_bt_line_y_dim) --
          (\dim_use:N \l_bt_draw_right_dim,\dim_use:N \l_bt_line_y_dim);
      }
    \int_add:Nn \l_bt_layer_cursor_int {#1}
  }

\cs_new_protected:Npn \bt_render_split_lines:nnnn #1#2#3#4
  {
    \dim_set:Nn \l_bt_draw_left_dim
      {(\l_bt_layer_left_dim + \l_bt_layer_right_dim - #4) / 2}
    \dim_set:Nn \l_bt_draw_right_dim
      {(\l_bt_layer_left_dim + \l_bt_layer_right_dim + #4) / 2}
    \bt_set_command_styles:nn {#1}{#2}
    \int_step_inline:nn {#1}
      {
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_command_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \dim_set:Nn \l_bt_line_y_dim
          {-\bt@operatorlineseparation * (\l_bt_layer_cursor_int + ##1 - 2)}
        \draw[bt/every~line,bt/current-line]
          (\dim_eval:n {\l_bt_layer_left_dim - \bt@stitchoverlap},
           \dim_use:N \l_bt_line_y_dim) --
          (\dim_eval:n {\l_bt_draw_left_dim + \bt@stitchoverlap},
           \dim_use:N \l_bt_line_y_dim);
      }
    \bt_set_command_styles:nn {#1}{#3}
    \int_step_inline:nn {#1}
      {
        \tl_set:Nx \l_bt_line_options_tl
          {\seq_item:Nn \l_bt_command_style_seq {##1}}
        \exp_args:NV \bt_prepare_line_options:n \l_bt_line_options_tl
        \dim_set:Nn \l_bt_line_y_dim
          {-\bt@operatorlineseparation * (\l_bt_layer_cursor_int + ##1 - 2)}
        \draw[bt/every~line,bt/current-line]
          (\dim_eval:n {\l_bt_draw_right_dim - \bt@stitchoverlap},
           \dim_use:N \l_bt_line_y_dim) --
          (\dim_eval:n {\l_bt_layer_right_dim + \bt@stitchoverlap},
           \dim_use:N \l_bt_line_y_dim);
      }
    \int_add:Nn \l_bt_layer_cursor_int {#1}
  }

\cs_new_protected:Npn \bt_render_operator_lines:nnnn #1#2#3#4
  {
    \bt_render_split_lines:nnnn {#2}{#3}{#4}{\bt@operatorwidth}
    \pgfmathsetlength{\l_bt_operator_y_dim}{
      -\the\bt@operatorlineseparation *
      (2 * \int_use:N \l_bt_layer_cursor_int - #2 - 3
       - \bt@operatortop + \bt@operatorbottom) / 2}
    \pgfmathsetlength{\l_bt_operator_height_dim}{
      \the\bt@operatorlineseparation *
      (#2 - 1 + \bt@operatortop + \bt@operatorbottom)}
    \str_if_eq:nnTF {#1}{S}
      {\bt_render_operator_node:nn {bt/symmetriser}{}}
      {\bt_render_operator_node:nn {bt/antisymmetriser}{}}
  }

\cs_new_protected:Npn \bt_render_general_operator:nnnn #1#2#3#4
  {
    \hbox_set:Nn \l_bt_operator_content_box {#4}
    \dim_set:Nn \l_bt_layer_content_width_dim
      {\dim_max:nn {\bt@operatorwidth}{\box_wd:N \l_bt_operator_content_box}}
    \bt_render_split_lines:nnnn
      {#1}{#2}{#3}{\l_bt_layer_content_width_dim}
    \pgfmathsetlength{\l_bt_operator_y_dim}{
      -\the\bt@operatorlineseparation *
      (2 * \int_use:N \l_bt_layer_cursor_int - #1 - 3
       - \bt@operatortop + \bt@operatorbottom) / 2}
    \pgfmathsetlength{\l_bt_operator_height_dim}{
      \the\bt@operatorlineseparation *
      (#1 - 1 + \bt@operatortop + \bt@operatorbottom)}
    \bt_render_operator_node:nn {bt/general-operator}{#4}
  }

\cs_new_protected:Npn \bt_render_operator_node:nn #1#2
  {
    \node[bt/operator,#1,
          minimum~height=\dim_use:N \l_bt_operator_height_dim]
      at ($
        (\dim_use:N \l_bt_layer_left_dim,\dim_use:N \l_bt_operator_y_dim)!.5!
        (\dim_use:N \l_bt_layer_right_dim,\dim_use:N \l_bt_operator_y_dim)
      $) {#2};
  }

