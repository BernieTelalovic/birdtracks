$ErrorActionPreference = "Stop"

$BirdtracksVersion = "__BIRDTRACKS_VERSION__"
$BirdtracksRoot = Join-Path $env:LOCALAPPDATA "Birdtracks"
$BirdtracksBin = Join-Path $BirdtracksRoot "bin"
$env:UV_INSTALL_DIR = $BirdtracksBin
$env:UV_TOOL_DIR = Join-Path $BirdtracksRoot "tools"
$env:UV_TOOL_BIN_DIR = $BirdtracksBin
$env:UV_PYTHON_INSTALL_DIR = Join-Path $BirdtracksRoot "python"

Invoke-RestMethod https://astral.sh/uv/install.ps1 | Invoke-Expression

$Uv = Join-Path $BirdtracksBin "uv.exe"
$Package = "birdtracks[coding] @ https://github.com/BernieTelalovic/birdtracks/archive/refs/tags/$BirdtracksVersion.tar.gz"
& $Uv tool install --force --python 3.12 $Package
if ($LASTEXITCODE -ne 0) {
    throw "Birdtracks installation failed."
}

$Whiteboard = Join-Path $BirdtracksBin "birdtracks-whiteboard.exe"
$WhiteboardAsset = (& $Whiteboard --asset-path birdtracks-whiteboard-file.ico).Trim()
$InstalledIcon = Join-Path $BirdtracksRoot "birdtracks-whiteboard-file-projector.ico"
Copy-Item -LiteralPath $WhiteboardAsset -Destination $InstalledIcon -Force
$WhiteboardType = "Birdtracks.Whiteboard"
New-Item -Path "HKCU:\Software\Classes\.whiteboard" -Force | Out-Null
New-ItemProperty -Path "HKCU:\Software\Classes\.whiteboard" -Name "(default)" `
    -Value $WhiteboardType -PropertyType String -Force | Out-Null
New-ItemProperty -Path "HKCU:\Software\Classes\.whiteboard" -Name "Content Type" `
    -Value "application/x-birdtracks-whiteboard" -PropertyType String -Force | Out-Null
New-Item -Path "HKCU:\Software\Classes\$WhiteboardType\DefaultIcon" -Force | Out-Null
Set-ItemProperty -Path "HKCU:\Software\Classes\$WhiteboardType\DefaultIcon" `
    -Name "(default)" -Value "`"$InstalledIcon`",0"
New-Item -Path "HKCU:\Software\Classes\$WhiteboardType\shell\open\command" -Force | Out-Null
Set-ItemProperty -Path "HKCU:\Software\Classes\$WhiteboardType\shell\open\command" `
    -Name "(default)" -Value "`"$Whiteboard`" `"%1`""
New-ItemProperty -Path "HKCU:\Software\Classes\$WhiteboardType" -Name "FriendlyTypeName" `
    -Value "Birdtracks whiteboard" -PropertyType String -Force | Out-Null

$Launcher = Join-Path $BirdtracksBin "birdtracks-lab.exe"
$Shell = New-Object -ComObject WScript.Shell
$Programs = [Environment]::GetFolderPath("Programs")
$BirdtracksPrograms = Join-Path $Programs "Birdtracks"
New-Item -ItemType Directory -Path $BirdtracksPrograms -Force | Out-Null
$WhiteboardShortcut = $Shell.CreateShortcut((Join-Path $BirdtracksPrograms "Birdtracks Whiteboard.lnk"))
$WhiteboardShortcut.TargetPath = $Whiteboard
$WhiteboardShortcut.WorkingDirectory = [Environment]::GetFolderPath("MyDocuments")
$WhiteboardShortcut.IconLocation = "$InstalledIcon,0"
$WhiteboardShortcut.Description = "Exact birdtrack projector whiteboard"
$WhiteboardShortcut.Save()

$Desktop = [Environment]::GetFolderPath("Desktop")
$Shortcut = $Shell.CreateShortcut((Join-Path $Desktop "Birdtracks Lab.lnk"))
$Shortcut.TargetPath = $Launcher
$Shortcut.WorkingDirectory = [Environment]::GetFolderPath("MyDocuments")
$Shortcut.Description = "Birdtrack algebra coding environment"
$Shortcut.Save()

Write-Host ""
Write-Host "Birdtracks Lab $BirdtracksVersion is installed."
Write-Host "Open Birdtracks Lab from its desktop shortcut."
Write-Host "Open Birdtracks Whiteboard from the Start menu or run:"
Write-Host "  $Whiteboard"
